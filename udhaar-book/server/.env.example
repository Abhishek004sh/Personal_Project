# Copy this file to ".env" and fill it in. Never share or upload the .env file.

# MongoDB connection string. A free MongoDB Atlas cluster works, or a local one:
# mongodb://127.0.0.1:27017/udhaar-book
MONGODB_URI=mongodb://127.0.0.1:27017/udhaar-book

# Long random text (at least 32 characters). Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# The password used to log in to the app (at least 8 characters).
ADMIN_PASSWORD=

PORT=5000

# Only for development when the React app runs on its own port:
# CORS_ORIGIN=http://localhost:5173

# Set to true only when hosted behind a proxy (Render, Railway, etc.)
# TRUST_PROXY=true
